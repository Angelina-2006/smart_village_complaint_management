<%@ include file="header.jspf" %>
<% Map<String,Object> c=(Map<String,Object>)request.getAttribute("complaint"); List<Map<String,Object>> history=(List<Map<String,Object>>)request.getAttribute("history"); Map<String,Object> feedback=(Map<String,Object>)request.getAttribute("feedback"); boolean resolved="Resolved".equals(c.get("status")); %>
<a class="back-link" href="<%=ctx%>/dashboard">← Back to overview</a><div class="page-heading"><div><span class="eyebrow">COMPLAINT DETAILS</span><h1><%=Html.e(c.get("title"))%></h1><p class="complaint-id"><%=Html.e(c.get("id"))%></p></div><span class="badge large <%=Html.badge(c.get("status"))%>">● &nbsp;<%=Html.e(c.get("status"))%></span></div>
<div class="detail-layout"><div><section class="panel form-panel"><div class="detail-meta"><div><span>Category</span><strong><%=Html.e(c.get("category"))%></strong></div><div><span>Submitted by</span><strong><%=Html.e(c.get("reporter"))%></strong></div><div><span>Submitted on</span><strong><%=Html.e(c.get("created_at"))%> UTC</strong></div><div><span>Verification</span><strong><%=Boolean.TRUE.equals(c.get("verified"))?"Verified by Panchayat":"Awaiting verification"%></strong></div><div><span>Assigned to</span><strong><%=c.get("assignee").toString().isBlank()?"Awaiting assignment":Html.e(c.get("assignee"))%></strong></div><div><span>Location</span><strong><%=Html.e(c.get("location"))%></strong></div></div>
<% if(c.get("latitude")!=null) { %><p class="coordinates">⌖ <%=Html.e(c.get("latitude"))%>, <%=Html.e(c.get("longitude"))%> <a target="_blank" rel="noopener noreferrer" href="https://www.openstreetmap.org/?mlat=<%=Html.e(c.get("latitude"))%>&amp;mlon=<%=Html.e(c.get("longitude"))%>#map=17/<%=Html.e(c.get("latitude"))%>/<%=Html.e(c.get("longitude"))%>">View on map ↗</a></p><% } %>
<hr><h3>About the complaint</h3><p class="description"><%=Html.e(c.get("description"))%></p><% if(c.get("photo_type")!=null) { %><h3>Photo evidence</h3><a href="<%=ctx%>/complaints/photo?id=<%=Html.e(c.get("id"))%>" target="_blank" rel="noopener"><img class="evidence" src="<%=ctx%>/complaints/photo?id=<%=Html.e(c.get("id"))%>" alt="Photo submitted as evidence for this complaint"></a><% } %></section>
<section class="panel form-panel timeline-panel"><h2>Progress history</h2><p class="muted">Every update, in one place. Times shown in UTC.</p><ol class="timeline"><% for(Map<String,Object> event:history) { %><li><span class="badge <%=Html.badge(event.get("status"))%>"><%=Html.e(event.get("status"))%></span><p class="description"><%=Html.e(event.get("note"))%></p><small><%=Html.e(event.get("name"))%> · <%=Html.e(event.get("created_at"))%></small></li><% } %></ol></section></div>
<aside><% if(me.isAdmin()&&!resolved) { %><section class="panel form-panel"><span class="eyebrow">PANCHAYAT ACTIONS</span><h2>Manage complaint</h2><form method="post" action="<%=ctx%>/complaints/update" class="form-stack"><input type="hidden" name="csrf" value="<%=Html.e(session.getAttribute("csrf"))%>"><input type="hidden" name="id" value="<%=Html.e(c.get("id"))%>"><label class="checkbox"><input type="checkbox" name="verified" <%=Boolean.TRUE.equals(c.get("verified"))?"checked":""%>> Complaint verified</label><label>Assign to team / officer<input name="assignee" maxlength="100" placeholder="e.g. Water supply team" value="<%=Html.e(c.get("assignee"))%>"></label><label>Status<select name="status"><% for(String s:ComplaintRepository.STATUSES) { %><option <%=s.equals(c.get("status"))?"selected":""%>><%=s%></option><% } %></select></label><label>Public update / resolution note<textarea name="note" rows="4" minlength="5" maxlength="700" required placeholder="Explain the work being done…"></textarea></label><small class="muted">Verify and assign before moving to Under Process. Resolve after work is complete.</small><button class="button primary full" type="submit">Save update →</button></form></section><% } %>
<% if(feedback!=null) { %><section class="panel form-panel feedback-card"><span class="eyebrow">RESIDENT FEEDBACK</span><h2><%=Html.e(feedback.get("rating"))%> / 5 <span class="stars">★</span></h2><p class="description"><%=Html.e(feedback.get("comment"))%></p><small class="muted">Thank you for helping us improve.</small></section><% } else if(resolved && ((Number)c.get("user_id")).longValue()==me.getId()) { %><section class="panel form-panel"><span class="eyebrow">YOUR OPINION MATTERS</span><h2>How did we do?</h2><p class="muted">Your complaint has been resolved. Share your experience.</p><form method="post" action="<%=ctx%>/complaints/feedback" class="form-stack"><input type="hidden" name="csrf" value="<%=Html.e(session.getAttribute("csrf"))%>"><input type="hidden" name="id" value="<%=Html.e(c.get("id"))%>"><label>Your rating<select name="rating" required><option value="">Choose a rating</option><option value="5">5 — Excellent</option><option value="4">4 — Good</option><option value="3">3 — Satisfactory</option><option value="2">2 — Needs improvement</option><option value="1">1 — Poor</option></select></label><label>Feedback<textarea name="comment" rows="4" minlength="5" maxlength="1000" required placeholder="Tell us about the resolution…"></textarea></label><button class="button primary full" type="submit">Send feedback →</button></form></section><% } else { %><section class="help-card"><span class="note-icon"><%=resolved?"✓":"◷"%></span><h3><%=resolved?"This complaint is resolved":"We’re with you along the way"%></h3><p><%=resolved?"The completed work and all updates are recorded in the progress history.":"Check back here for verified updates from your Panchayat. Once resolved, you can share your feedback."%></p></section><% } %></aside></div>
<%@ include file="footer.jspf" %>
