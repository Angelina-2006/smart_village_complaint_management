<%@ include file="header.jspf" %>
<% List<Map<String,Object>> complaints=(List<Map<String,Object>>)request.getAttribute("complaints"); Map<String,Long> counts=(Map<String,Long>)request.getAttribute("counts"); String filter=request.getParameter("status"); filter=filter==null?"":filter; %>
<div class="page-heading"><div><span class="eyebrow"><%=me.isAdmin()?"PANCHAYAT WORKSPACE":"YOUR COMMUNITY, AT A GLANCE"%></span><h1><%=me.isAdmin()?"Village overview":"Welcome, "+Html.e(me.getName().split(" ")[0])%> <span class="wave">☀</span></h1><p>Small actions make a big difference. Let’s build a better village together.</p></div><a class="button primary" href="<%=ctx%>/complaints/new">＋ &nbsp; Report a complaint</a></div>
<section class="hero"><div><span class="hero-kicker"><span class="live-dot"></span> A BETTER VILLAGE STARTS HERE</span><h2>Your concerns.<br>Our shared responsibility.</h2><p>From a broken streetlight to a water supply issue,<br>make it known. We’ll help move it forward.</p><a href="<%=ctx%>/complaints/new" class="hero-link">Let’s make a difference <span>↗</span></a></div><div class="village-art" aria-hidden="true"><div class="art-sun"></div><div class="art-cloud"></div><div class="art-hill back"></div><div class="art-hill front"></div><div class="building one"><i></i><b></b></div><div class="building two"><i></i><b></b></div><div class="art-tree left"></div><div class="art-tree right"></div><div class="art-path"></div><span class="art-caption">Growing together, every day.</span></div></section>
<section class="stats" aria-label="Complaint statistics"><% String[] labels={"Total","Pending","Under Process","Resolved"}; String[] icons={"▤","◷","↻","✓"}; for(int i=0;i<labels.length;i++) { %><a href="<%=ctx%>/dashboard<%=i==0?"":"?status="+java.net.URLEncoder.encode(labels[i],java.nio.charset.StandardCharsets.UTF_8)%>" class="stat"><div class="stat-top"><span><%=i==0?"Total complaints":labels[i]%></span><span class="stat-icon s<%=i%>"><%=icons[i]%></span></div><strong><%=counts.get(labels[i])%></strong><small><%=new String[]{"Every concern counts","Awaiting attention","Work is in progress","Making a difference"}[i]%></small></a><% } %></section>
<section class="panel complaints-panel"><div class="panel-heading"><div><h2><%=me.isAdmin()?"Community complaints":"Your complaints"%> <span class="count-pill"><%=counts.get("Total")%></span></h2><p>Stay informed, from the first report to the final resolution.</p></div><span class="subtle-label">LATEST ACTIVITY</span></div>
<form method="get" action="<%=ctx%>/dashboard" class="filters"><label class="search-field"><span>⌕</span><input name="q" aria-label="Search by title or complaint ID" placeholder="Search by title or complaint ID…" maxlength="150" value="<%=Html.e(request.getParameter("q"))%>"></label><select name="status" aria-label="Filter by status"><option value="">All statuses</option><% for(String s:ComplaintRepository.STATUSES) { %><option <%=s.equals(filter)?"selected":""%>><%=s%></option><% } %></select><button class="button secondary" type="submit">Apply filters</button><% if(!filter.isEmpty() || request.getParameter("q")!=null) { %><a class="text-link" href="<%=ctx%>/dashboard">Clear</a><% } %></form>
<% if(complaints.isEmpty()) { %><div class="empty-state"><div class="empty-icon">♧</div><h3><%=counts.get("Total")==0?"A fresh start for your village":"No matching complaints"%></h3><p><%=counts.get("Total")==0?"Spotted something that needs attention? Your first report can make a difference.":"Try another title, complaint ID, or status."%></p><a class="button secondary" href="<%=ctx%><%=counts.get("Total")==0?"/complaints/new":"/dashboard"%>"><%=counts.get("Total")==0?"Report your first complaint":"View all complaints"%> →</a></div><% } else { %>
<div class="table-scroll"><table><thead><tr><th>COMPLAINT</th><th>CATEGORY</th><th>LOCATION</th><th>STATUS</th><th>SUBMITTED</th><th><span class="sr-only">Open</span></th></tr></thead><tbody><% for(Map<String,Object> c:complaints) { %><tr><td><a class="complaint-title" href="<%=ctx%>/complaints/view?id=<%=Html.e(c.get("id"))%>"><%=Html.e(c.get("title"))%></a><span class="table-id" title="<%=Html.e(c.get("id"))%>"><%=Html.e(c.get("id"))%></span></td><td><span class="category"><%=Html.e(c.get("category"))%></span></td><td class="location-cell"><%=Html.e(c.get("location"))%></td><td><span class="badge <%=Html.badge(c.get("status"))%>">● &nbsp;<%=Html.e(c.get("status"))%></span></td><td class="date-cell"><%=Html.e(c.get("created_at").toString().substring(0,10))%></td><td><a class="row-arrow" aria-label="View complaint" href="<%=ctx%>/complaints/view?id=<%=Html.e(c.get("id"))%>">↗</a></td></tr><% } %></tbody></table></div><div class="table-footer">Showing <%=complaints.size()%> most recent matching complaints <span>Updated as your community takes action</span></div><% } %></section>
<div class="bottom-note"><span>ⓘ</span><p><strong>A little detail goes a long way.</strong> Add a clear photo and location to help the Panchayat resolve your complaint faster.</p><a href="<%=ctx%>/complaints/new">Report an issue →</a></div>
<%@ include file="footer.jspf" %>
