<%@ include file="header.jspf" %>
<a class="back-link" href="<%=ctx%>/dashboard">← Back to overview</a><div class="page-heading"><div><span class="eyebrow">LET’S MAKE THINGS BETTER</span><h1>Report a complaint</h1><p>Tell us what needs attention. We’ll keep you updated along the way.</p></div></div>
<div class="form-layout"><section class="panel form-panel"><h2>Complaint details</h2><p class="muted">Fields marked * are required.</p><form method="post" enctype="multipart/form-data" action="<%=ctx%>/complaints/new" class="form-stack"><input type="hidden" name="csrf" value="<%=Html.e(session.getAttribute("csrf"))%>">
<label>Complaint title *<input name="title" minlength="5" maxlength="150" required placeholder="e.g. Streetlight not working near the school" value="<%=Html.e(request.getParameter("title"))%>"></label>
<label>Category *<select name="category" required><option value="">Select a category</option><% for(String c:ComplaintRepository.CATEGORIES) { %><option <%=c.equals(request.getParameter("category"))?"selected":""%>><%=c%></option><% } %></select></label>
<label>Description *<textarea name="description" minlength="20" maxlength="5000" rows="5" required placeholder="Describe the issue, when it started, and who is affected…"><%=Html.e(request.getParameter("description"))%></textarea><small>Include enough detail to help the team understand the issue (at least 20 characters).</small></label>
<label>Location / nearest landmark *<input name="location" minlength="5" maxlength="250" required placeholder="Street, ward, and a nearby landmark" value="<%=Html.e(request.getParameter("location"))%>"></label>
<div class="gps-row"><button type="button" id="get-location" class="button secondary">⌖ &nbsp; Use my current location</button><span id="location-status" class="muted" role="status">Optional · Helps us find the exact spot</span></div>
<div class="two-col"><label>Latitude<input type="number" step="any" min="-90" max="90" name="latitude" id="latitude" value="<%=Html.e(request.getParameter("latitude"))%>" placeholder="e.g. 12.9716"></label><label>Longitude<input type="number" step="any" min="-180" max="180" name="longitude" id="longitude" value="<%=Html.e(request.getParameter("longitude"))%>" placeholder="e.g. 77.5946"></label></div>
<label class="upload-box"><span class="upload-icon">↥</span><strong>Add photo evidence</strong><span>Choose a clear photo of the issue</span><input type="file" name="photo" id="photo" accept="image/jpeg,image/png"><small>JPEG or PNG · Up to 5 MB · Up to 24 megapixels</small></label><img id="photo-preview" class="photo-preview" hidden alt="Selected complaint photo"><p id="photo-status" class="muted" role="status"></p>
<div class="form-actions"><a class="button secondary" href="<%=ctx%>/dashboard">Cancel</a><button type="submit" class="button primary">Submit complaint →</button></div></form></section>
<aside class="help-card"><span class="note-icon">♧</span><h3>What happens next?</h3><ol class="steps"><li><strong>We receive your report</strong><p>You’ll get a unique complaint ID immediately.</p></li><li><strong>The Panchayat reviews it</strong><p>Your complaint is verified and assigned to the right team.</p></li><li><strong>Follow the progress</strong><p>Check your dashboard for updates and resolution notes.</p></li><li><strong>Share your feedback</strong><p>Let us know how we did after the issue is resolved.</p></li></ol><div class="help-tip">For immediate danger or emergencies, contact your local emergency services directly.</div></aside></div>
<%@ include file="footer.jspf" %>
