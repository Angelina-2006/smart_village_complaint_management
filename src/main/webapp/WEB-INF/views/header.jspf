<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" import="java.util.*,org.smartvillage.model.User,org.smartvillage.web.Html,org.smartvillage.db.ComplaintRepository" %>
<% User me=(User)session.getAttribute("user"); String ctx=request.getContextPath(); String pagePath=(String)request.getAttribute("jakarta.servlet.forward.servlet_path"); if(pagePath==null) pagePath=request.getServletPath(); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Smart Village · Community care</title><link rel="stylesheet" href="<%=ctx%>/assets/app.css"><script defer src="<%=ctx%>/assets/app.js"></script></head><body>
<div class="app-shell"><aside class="sidebar"><a class="brand" href="<%=ctx%>/dashboard"><span class="brand-mark">⌂</span><span>smart<span class="brand-light">village</span><small>BETTER TOGETHER</small></span></a>
<div class="village-label"><span class="live-dot"></span> Your village, connected</div>
<p class="nav-label">WORKSPACE</p><nav aria-label="Main navigation"><a class="nav-item <%=pagePath.equals("/dashboard")?"active":""%>" href="<%=ctx%>/dashboard"><span>▦</span> Overview</a><a class="nav-item <%=pagePath.equals("/complaints/new")?"active":""%>" href="<%=ctx%>/complaints/new"><span>＋</span> Report a complaint</a><a class="nav-item" href="<%=ctx%>/dashboard?status=Resolved"><span>✓</span> Resolved complaints</a></nav>
<div class="sidebar-note"><span class="note-icon">♧</span><strong>Small actions.<br>Stronger villages.</strong><p>Every report is a step towards a better place to live.</p></div>
<div class="profile"><div class="avatar"><%=Html.e(me==null?"V":me.getName().substring(0,1).toUpperCase())%></div><div><strong><%=Html.e(me==null?"Welcome":me.getName())%></strong><small><%=me!=null&&me.isAdmin()?"Panchayat authority":"Village resident"%></small></div></div>
<% if(me!=null) { %><form method="post" action="<%=ctx%>/logout"><input type="hidden" name="csrf" value="<%=Html.e(session.getAttribute("csrf"))%>"><button class="logout" type="submit">Sign out ↗</button></form><% } %>
</aside><div class="workspace"><header class="topbar"><span>Community services <span class="breadcrumb">/ &nbsp; Complaint management</span></span><div><span class="live-dot"></span> Panchayat portal <span class="top-avatar">SV</span></div></header><main>
<% Object flash=session.getAttribute("flash"); if(flash!=null) { session.removeAttribute("flash"); %><div class="notice success" role="status"><%=Html.e(flash)%></div><% } Object error=request.getAttribute("error"); if(error==null) { error=session.getAttribute("error"); session.removeAttribute("error"); } if(error!=null) { %><div class="notice error" role="alert"><%=Html.e(error)%></div><% } %>
